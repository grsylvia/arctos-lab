<?xml version="1.0"?>
<!-- Use ROS package manifest format 3. -->
<package format="3">
  <!-- Identify the package for ROS commands and dependency lookup. -->
  <name>arctos_description</name>
  <!-- Mark the initial local description release. -->
  <version>0.1.0</version>
  <!-- Describe the package's purpose and geometry source. -->
  <description>Initial Arctos description using locally purchased CAD meshes.</description>
  <!-- Keep a placeholder maintainer contact during local development. -->
  <maintainer email="gsylvia@example.com">gsylvia</maintainer>
  <!-- Declare the current private development license. -->
  <license>Proprietary</license>
  <!-- Build and install the package with ament CMake. -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- Read geometry settings in the mesh preparation script. -->
  <exec_depend>python3-yaml</exec_depend>
  <!-- Expose build metadata to ROS tooling. -->
  <export>
    <!-- Select the ament CMake build system. -->
    <build_type>ament_cmake</build_type>
  </export>
</package>
