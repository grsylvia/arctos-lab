<?xml version="1.0"?>
<robot name="arctos">
  <material name="structure">
    <color rgba="0.25 0.35 0.45 1"/>
  </material>

  <!-- Visuals retain detailed CAD meshes; collision meshes are simplified locally, with mm-to-metre scale. -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://arctos_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="structure"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://arctos_description/meshes/collision/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="shoulder_link">
    <visual>
      <geometry>
        <mesh filename="package://arctos_description/meshes/shoulder_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="structure"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://arctos_description/meshes/collision/shoulder_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="upper_arm_link">
    <visual>
      <geometry>
        <mesh filename="package://arctos_description/meshes/upper_arm_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="structure"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://arctos_description/meshes/collision/upper_arm_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="elbow_link">
    <visual>
      <geometry>
        <mesh filename="package://arctos_description/meshes/elbow_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="structure"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://arctos_description/meshes/collision/elbow_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="wrist_roll_link">
    <visual>
      <geometry>
        <mesh filename="package://arctos_description/meshes/wrist_roll_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="structure"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://arctos_description/meshes/collision/wrist_roll_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="wrist_pitch_link">
    <visual>
      <geometry>
        <mesh filename="package://arctos_description/meshes/wrist_pitch_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="structure"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://arctos_description/meshes/collision/wrist_pitch_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="tool_link">
    <visual>
      <geometry>
        <mesh filename="package://arctos_description/meshes/tool_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="structure"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://arctos_description/meshes/collision/tool_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- Define the tool-mounting face frame, X out of the face (ROS-Industrial flange). -->
  <link name="flange"/>

  <!-- Define the tool frame, Z out of the face (ROS-Industrial tool0). -->
  <link name="tool0"/>

  <!-- Joint offsets are in metres; rotations and limits are in radians. -->
  <!-- Limits come from joint_limits.py; zero effort and velocity are unverified placeholders. -->
  <!-- Joints 1, 4, 5, and 6 default to ±180° when the sweep finds no collision within 360°. -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.129906" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141593" upper="3.141593" effort="0" velocity="0"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0.020885 0 0.157722" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- joint_limits.py: collisions at −80.2° (shoulder), +75.9° (tool on base) ÷ 1.5. -->
    <limit lower="-0.933024" upper="0.883573" effort="0" velocity="0"/>
  </joint>

  <joint name="joint_3" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="elbow_link"/>
    <origin xyz="-0.00131 0.000065 0.261007" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- joint_limits.py: collisions at −203.7° and +69.0° (upper arm) ÷ 1.5. -->
    <limit lower="-2.370012" upper="0.802851" effort="0" velocity="0"/>
  </joint>

  <joint name="joint_4" type="revolute">
    <parent link="elbow_link"/>
    <child link="wrist_roll_link"/>
    <origin xyz="0.135759 0 0.021705" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.141593" upper="3.141593" effort="0" velocity="0"/>
  </joint>

  <joint name="joint_5" type="revolute">
    <parent link="wrist_roll_link"/>
    <child link="wrist_pitch_link"/>
    <origin xyz="0.128424 0.000244 -0.001774" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.141593" upper="3.141593" effort="0" velocity="0"/>
  </joint>

  <joint name="joint_6" type="revolute">
    <parent link="wrist_pitch_link"/>
    <child link="tool_link"/>
    <origin xyz="0.035835 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.141593" upper="3.141593" effort="0" velocity="0"/>
  </joint>

  <joint name="joint_6-flange" type="fixed">
    <parent link="tool_link"/>
    <child link="flange"/>
    <!-- Place the frame on the C-core outer face, 13 mm out along the joint_6 axis. -->
    <origin xyz="0.013 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="flange-tool0" type="fixed">
    <parent link="flange"/>
    <child link="tool0"/>
    <!-- Use the ROS-Industrial rotation: Z along flange X, X along flange Z. -->
    <origin xyz="0 0 0" rpy="3.141593 -1.570796 0"/>
  </joint>
</robot>
